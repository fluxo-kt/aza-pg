    {
      "name": "pgsodium",
      "nix": {
        "package": "pgsodium",
        "postInstall": "ln -sf /usr/share/postgresql/@pgMajor@/extension/pgsodium_getkey $out/share/postgresql/extension/pgsodium_getkey\nrm -r $out/share/pgsodium/getkey_scripts"
      },
      "kind": "extension",
      "category": "security",
      "description": "Modern cryptography and envelope encryption with libsodium.",
      "source": {
        "type": "git",
        "repository": "https://github.com/michelp/pgsodium.git",
        "tag": "v3.1.11",
        "commit": "a8b8a2739bab1f7a07445b1c911e2bd1abf67784"
      },
      "build": {
        "type": "pgxs",
        "makeOptions": [
          "PG_CPPFLAGS="
        ]
      },
      "runtime": {
        "sharedPreload": true,
        "defaultEnable": true,
        "notes": [
