+pub fn distance_cosine_x86_dispatch(x: &[f32], y: &[f32]) -> f32 {
+    (1.0 - inner_product_x86_dispatch(x, y)).max(0.0)
+}
+
+pub fn distance_xor_x86_dispatch(a: &[u64], b: &[u64]) -> usize {
+    // SAFETY: as in distance_l2_x86_dispatch.
+    unsafe { (kernels().xor)(a, b) }
 }
 
