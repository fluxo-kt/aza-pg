+/// A distance kernel; `unsafe` because it may point at a `#[target_feature]` function.
+type F32Kernel = unsafe fn(&[f32], &[f32]) -> f32;
+/// A hamming-distance kernel over binary-quantized vectors.
+type XorKernel = unsafe fn(&[u64], &[u64]) -> usize;
+
+struct Kernels {
+    l2: F32Kernel,
+    inner_product: F32Kernel,
+    xor: XorKernel,
+}
+
+// simdeez's `*_runtime_select` is not used: it checks avx2 but never fma, re-checks on every call, and
+// its `*_avx2` variant enables only avx2, so `_mm256_fmadd_ps` cannot inline there yet still runs FMA.
+// Enabling avx2+fma together lets FMA inline, the codegen upstream got from its global `+avx2,+fma`.
+#[target_feature(enable = "avx2,fma")]
+unsafe fn distance_l2_x86_avx2_fma(x: &[f32], y: &[f32]) -> f32 {
+    distance_l2_x86::<Avx2>(x, y)
+}
+
+#[target_feature(enable = "avx2,fma")]
+unsafe fn inner_product_x86_avx2_fma(x: &[f32], y: &[f32]) -> f32 {
+    inner_product_x86::<Avx2>(x, y)
+}
+
+// The SBQ hamming distance is plain Rust that upstream's global flags auto-vectorized with AVX2;
+// compiling the same body under avx2+fma keeps that codegen on CPUs that have them.
+#[target_feature(enable = "avx2,fma")]
+unsafe fn distance_xor_x86_avx2_fma(a: &[u64], b: &[u64]) -> usize {
+    super::distance_xor_portable(a, b)
+}
+
+fn distance_xor_x86_baseline(a: &[u64], b: &[u64]) -> usize {
+    super::distance_xor_portable(a, b)
+}
+
+/// Picks the fastest kernels this CPU can execute, detecting features once per backend process.
+fn kernels() -> &'static Kernels {
+    static KERNELS: OnceLock<Kernels> = OnceLock::new();
+    KERNELS.get_or_init(|| {
+        if is_x86_feature_detected!("avx2") && is_x86_feature_detected!("fma") {
+            Kernels {
+                l2: distance_l2_x86_avx2_fma,
+                inner_product: inner_product_x86_avx2_fma,
+                xor: distance_xor_x86_avx2_fma,
+            }
+        } else if is_x86_feature_detected!("sse4.1") {
+            Kernels {
+                l2: distance_l2_x86_sse41,
+                inner_product: inner_product_x86_sse41,
+                xor: distance_xor_x86_baseline,
+            }
+        } else if is_x86_feature_detected!("sse2") {
+            Kernels {
+                l2: distance_l2_x86_sse2,
+                inner_product: inner_product_x86_sse2,
+                xor: distance_xor_x86_baseline,
+            }
+        } else {
+            Kernels {
+                l2: distance_l2_x86_scalar,
+                inner_product: inner_product_x86_scalar,
+                xor: distance_xor_x86_baseline,
+            }
+        }
+    })
+}
+
+/// Runs feature detection at load time so the first query does not pay for it.
+pub fn init() {
+    kernels();
+}
+
+pub fn distance_l2_x86_dispatch(x: &[f32], y: &[f32]) -> f32 {
+    // SAFETY: kernels() stores a #[target_feature] function only after detecting its features on this CPU.
+    unsafe { (kernels().l2)(x, y) }
+}
+
+pub fn inner_product_x86_dispatch(x: &[f32], y: &[f32]) -> f32 {
+    // SAFETY: as in distance_l2_x86_dispatch.
+    unsafe { (kernels().inner_product)(x, y) }
+}
+
